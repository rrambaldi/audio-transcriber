# cmd.exe mis-parses batch files with LF-only line endings - labels and
# "goto" stop working - so these keep CRLF whatever a checkout's
# core.autocrlf says.
*.cmd text eol=crlf
*.bat text eol=crlf

# setup.cmd is downloaded on its own, straight from GitHub, by people who have
# no checkout: what they get is the blob as stored, so the blob itself has to
# be CRLF rather than become CRLF on checkout.
setup.cmd -text

# The icon renders, the .ico container and the typefaces: never let a checkout
# rewrite line endings inside a binary file.
*.png binary
*.ico binary
*.ttf binary
*.woff2 binary
