# cmd.exe mis-parses batch files with LF-only line endings - labels and
# "goto" stop working - so these keep CRLF whatever a checkout's
# core.autocrlf says.
*.cmd text eol=crlf
*.bat text eol=crlf

# The icon renders, the .ico container and the typefaces: never let a checkout
# rewrite line endings inside a binary file.
*.png binary
*.ico binary
*.ttf binary
*.woff2 binary
